{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskify-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://taskify-api.deepeshk12041992.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taskify",
      "database_id": "7478a937-19ef-48c3-8787-42c2db6fe77e",
    },
  ],
}
